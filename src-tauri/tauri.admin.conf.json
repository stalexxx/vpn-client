{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VPN Admin",
  "version": "0.3.35",
  "identifier": "local.vpn-client.admin",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Администрирование VPN",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "url": "admin-gpui.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
